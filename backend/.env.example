# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL).
# Example for local dev: http://localhost:5173
# Example for production: https://vietentrytravel.com,https://www.vietentrytravel.com
FRONTEND_ORIGIN=http://localhost:5173

# SMTP credentials used to send the quote-request email.
# For Gmail: enable 2-Step Verification on the account, then create an
# "App password" at https://myaccount.google.com/apppasswords and use it
# below instead of the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password

# Where quote requests are delivered. Can be the same as SMTP_USER, or any
# inbox the team checks (e.g. info@vietentrytravel.com).
OWNER_EMAIL=info@vietentrytravel.com
