{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "viet-entry-travel-backend",
  // Deployment target: Cloudflare Workers
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SMTP_HOST": "pro218.emailserver.vn",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "OWNER_EMAIL": "info@vietentrytravel.com",
    "FRONTEND_ORIGIN": "https://vietentrytravel.com,https://www.vietentrytravel.com,http://localhost:5173"
  }
}
